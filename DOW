Dim lastDay As DateTime = New DateTime(Now.Year, Now.Month, DateTime.DaysInMonth(Now.Year, Now.Month))

dtFiltered = (From row In dtInput.AsEnumerable()
              Where CDate(row("Invoice Date").ToString) < lastDay
              AndAlso CDbl(row("Invoice Total")) <= 10000000
              AndAlso CInt(row("GL Account")) >= 600000 AndAlso CInt(row("GL Account")) <= 699999
              AndAlso Not {"Created","ECC","Service","Suspended"}.Contains(row("fDP Account").ToString.Trim)
              Select row).CopyToDataTable()
