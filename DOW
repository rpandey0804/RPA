' compute current month range
Dim firstDay As New DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
Dim lastDay As DateTime = firstDay.AddMonths(1).AddDays(-1)

Dim formats() As String = {"M/d/yyyy", "MM/dd/yyyy", "yyyy-MM-dd"} ' adjust/add formats if needed

Dim filtered As DataTable = Nothing

Dim rows = From row In dtInput.AsEnumerable()
           Let invDateStr = row.Field(Of String)("Invoice Date").Trim()
           Let parsed = (Function()
                            Dim d As DateTime
                            If DateTime.TryParseExact(invDateStr, formats, Globalization.CultureInfo.InvariantCulture, Globalization.DateTimeStyles.None, d) Then
                                Return CType(d, DateTime?)
                            ElseIf DateTime.TryParse(invDateStr, d) Then
                                Return CType(d, DateTime?)
                            Else
                                Return CType(Nothing, DateTime?)
                            End If
                         End Function)()
           Where parsed.HasValue _
                 AndAlso parsed.Value >= firstDay AndAlso parsed.Value <= lastDay _
                 AndAlso Double.TryParse(row("Invoice Total").ToString(), Globalization.NumberStyles.Any, Globalization.CultureInfo.InvariantCulture, Nothing) _
                     AndAlso CDbl(row("Invoice Total")) <= 10000000 _
                 AndAlso Integer.TryParse(row("GL Account").ToString(), Nothing) _
                     AndAlso CInt(row("GL Account")) >= 600000 AndAlso CInt(row("GL Account")) <= 699999 _
                 AndAlso Not {"Created","ECC","Service","Suspended"}.Contains(row("fDP Account").ToString().Trim())
           Select row

If rows.Any() Then
    filtered = rows.CopyToDataTable()
Else
    filtered = dtInput.Clone() ' empty table with same schema
End If
