Option Strict On
Imports System.Data
Imports System.Text.RegularExpressions

' Calculate first & last day of current month
Dim firstDay As DateTime = New DateTime(Now.Year, Now.Month, 1)
Dim lastDay As DateTime = New DateTime(Now.Year, Now.Month, DateTime.DaysInMonth(Now.Year, Now.Month))

' Query: keep only rows where Invoice Date is in current month (between firstDay and lastDay inclusive),
' invoice total <= 10,000,000, GL between 600000 and 699999 (ignore non-digits), and fDP not in blacklist.
Dim query = From row In dtInput.AsEnumerable()
            Let invDateStr = row("Invoice Date").ToString().Trim()
            Let invDate = If(String.IsNullOrWhiteSpace(invDateStr), DateTime.MaxValue, DateTime.Parse(invDateStr))
            Let invTotalStr = row("Invoice Total").ToString().Trim()
            Let invTotalClean = If(String.IsNullOrWhiteSpace(invTotalStr), 0D, Decimal.Parse(System.Text.RegularExpressions.Regex.Replace(invTotalStr, "[^\d\.\-]", "")))
            Let glRaw = row("GL Account").ToString().Trim()
            Let glDigits = Regex.Replace(glRaw, "\D", "")            ' strip non-digits
            Let gl = If(String.IsNullOrEmpty(glDigits), -1, Convert.ToInt32(glDigits))
            Let fdp = row("fDP Account").ToString().Trim()
            Where invDate >= firstDay AndAlso invDate <= lastDay _
              AndAlso invTotalClean <= 10000000D _
              AndAlso gl >= 600000 AndAlso gl <= 699999 _
              AndAlso Not (New String() {"Created","ECC","Service","Suspended"}).Contains(fdp)
            Select row

If query.Any() Then
    dtFiltered = query.CopyToDataTable()
Else
    dtFiltered = dtInput.Clone() ' empty table with same schema
End If
