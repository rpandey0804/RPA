Dim Timer as Date = DateAdd("s",Timeout-2,Now())
flag_IsAlive = False

Try
	flag_IsAlive = ExecWithTimeout(Timeout, "Check Thread Status",
	Function() 
		Dim flag_Alive as Boolean = False
		Try
			flag_Alive = threadObject.IsAlive
		Catch e As Exception
			flag_Alive = false
		End Try
	Return flag_Alive
	End Function)

Catch e As Exception When Now()>Timer
	'Excel crashed (not responding?)
	flag_IsAlive = True

Catch e As Exception 
	'WB/Macro not foundcall?
sni
	flag_IsAlive = False
End Try
