Sub creatednptemp()
Sheet4.Rows("2:10000").ClearContents
counterdnp = 2
With Sheet3
    lastusedrow = .Cells(.Rows.Count, "A").End(xlUp).Row
End With

    For counter = 2 To lastusedrow
        If Left(Sheet3.Range("AD" & counter).Value, 11) <> "Do Not Post" Then
            'do nothing
        Else
            Sheet4.Range("A" & counterdnp & ":BO" & counterdnp + 1).Value = "/"
            Sheet4.Range("A" & counterdnp & ":A" & counterdnp + 1).Value = Sheet3.Range("A" & counter).Value
            Sheet4.Range("B" & counterdnp & ":C" & counterdnp + 1).Value = Sheet2.Range("H4").Value
            Sheet4.Range("D" & counterdnp & ":D" & counterdnp + 1).Value = "J2"
            Sheet4.Range("E" & counterdnp & ":E" & counterdnp + 1).Value = Sheet3.Range("C" & counter).Value
            Sheet4.Range("G" & counterdnp & ":G" & counterdnp + 1).Value = Sheet3.Range("AB" & counter).Value
            Sheet4.Range("J" & counterdnp & ":J" & counterdnp + 1).Value = Replace(Sheet3.Range("L" & counter).Value, ",", "")
            Sheet4.Range("O" & counterdnp & ":O" & counterdnp + 1).Value = Sheet2.Range("H5").Value
            Sheet4.Range("P" & counterdnp & ":P" & counterdnp + 1).Value = "05"
            If Sheet3.Range("AA" & counter).Value > 0 Then
                Sheet4.Range("Q" & counterdnp).Value = "40"
                Sheet4.Range("Q" & counterdnp + 1).Value = "50"
            Else
                Sheet4.Range("Q" & counterdnp).Value = "50"
                Sheet4.Range("Q" & counterdnp + 1).Value = "40"
            End If
            Sheet4.Range("R" & counterdnp).Value = Sheet3.Range("Q" & counter).Value
            Sheet4.Range("R" & counterdnp + 1).Value = "320067"
            If Sheet3.Range("AB" & counter).Value = "BRL" Then
            Sheet4.Range("S" & counterdnp & ":S" & counterdnp + 1).Value = Sheet3.Range("L" & counter).Value & "; Invoice " & Sheet3.Range("J" & counterdnp).Value & "; DP# " & Sheet3.Range("D" & counter).Value
            Else
            Sheet4.Range("S" & counterdnp & ":S" & counterdnp + 1).Value = Format(Sheet2.Range("H3").Value, "MMMM") & "; AUTOACCRUAL DP# " & Sheet3.Range("D" & counter).Value & "; PO# " & Sheet3.Range("H" & counter).Value
            End If
            Sheet4.Range("U" & counterdnp & ":U" & counterdnp + 1).Value = Sheet3.Range("AA" & counter).Value
            Sheet4.Range("W" & counterdnp).Value = Sheet3.Range("AC" & counter).Value
            Sheet4.Range("BH" & counterdnp & ":BH" & counterdnp + 1).Value = Sheet3.Range("H" & counter).Value
            Sheet4.Range("BI" & counterdnp & ":BI" & counterdnp + 1).Value = Sheet3.Range("I" & counter).Value
            If Sheet3.Range("B" & counter).Value = "Network" Then
                Sheet4.Range("AF" & counterdnp & ":AF" & counterdnp + 1).Value = "NW." & Sheet3.Range("W" & counter).Value
                Sheet4.Range("BF" & counterdnp).Value = Sheet3.Range("W" & counter).Value
                Sheet4.Range("BG" & counterdnp).Value = Sheet3.Range("X" & counter).Value
            ElseIf Sheet3.Range("B" & counter).Value = "WBS" Then
                Sheet4.Range("AF" & counterdnp & ":AF" & counterdnp + 1).Value = Sheet3.Range("U" & counter).Value
                Sheet4.Range("AI" & counterdnp).Value = Sheet3.Range("U" & counter).Value
            ElseIf Sheet3.Range("B" & counter).Value = "Order" Then
                Sheet4.Range("Z" & counterdnp).Value = Sheet3.Range("S" & counter).Value
                Sheet4.Range("AF" & counterdnp & ":AF" & counterdnp + 1).Value = "O." & Sheet3.Range("S" & counter).Value
            Else
                Sheet4.Range("Y" & counterdnp).Value = Sheet3.Range("O" & counter).Value
                Sheet4.Range("AF" & counterdnp & ":AF" & counterdnp + 1).Value = Sheet3.Range("O" & counter).Value
            End If
            counterdnp = counterdnp + 2
        End If
        
     Next
        
