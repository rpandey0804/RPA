' --- Invoke Code (VB) ---
' Arguments:
'   dtInput  (In)  As System.Data.DataTable
'   filtered (Out) As System.Data.DataTable

Dim firstDay As New DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
Dim lastDay As DateTime = firstDay.AddMonths(1).AddDays(-1)
Dim formats() As String = {"M/d/yyyy", "MM/dd/yyyy", "yyyy-MM-dd"}

' create output table with same schema
filtered = dtInput.Clone()

For Each r As System.Data.DataRow In dtInput.Rows
    Dim invCell As String = If(IsDBNull(r("Invoice Date")), String.Empty, r("Invoice Date").ToString().Trim())
    If String.IsNullOrWhiteSpace(invCell) Then
        Continue For
    End If

    Dim parts() As String = invCell.Split({","c}, StringSplitOptions.RemoveEmptyEntries)
    Dim keepRow As Boolean = False

    For Each p As String In parts
        Dim candidate As String = p.Trim()
        Dim d As DateTime

        If DateTime.TryParseExact(candidate, formats, Globalization.CultureInfo.InvariantCulture, Globalization.DateTimeStyles.None, d) _
           OrElse DateTime.TryParse(candidate, d) Then

            If d >= firstDay AndAlso d <= lastDay Then
                keepRow = True
                Exit For
            End If
        End If
    Next

    If keepRow Then
        filtered.ImportRow(r)
    End If
Next
' --- end Invoke Code ---
