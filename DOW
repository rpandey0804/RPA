' Inputs: filePath (In As String)
' Output: dataTableResult (Out As System.Data.DataTable)

Dim excelApp As Microsoft.Office.Interop.Excel.Application = Nothing
Dim workbook As Microsoft.Office.Interop.Excel.Workbook = Nothing
Dim worksheet As Microsoft.Office.Interop.Excel.Worksheet = Nothing
Dim usedRange As Microsoft.Office.Interop.Excel.Range = Nothing

Try
    excelApp = New Microsoft.Office.Interop.Excel.ApplicationClass()
    workbook = excelApp.Workbooks.Open(filePath, UpdateLinks:=0, ReadOnly:=True)
    worksheet = CType(workbook.Sheets(1), Microsoft.Office.Interop.Excel.Worksheet)
    usedRange = worksheet.UsedRange

    Dim rows As Integer = If(usedRange IsNot Nothing, usedRange.Rows.Count, 0)
    Dim cols As Integer = If(usedRange IsNot Nothing, usedRange.Columns.Count, 0)

    Dim dt As New System.Data.DataTable()

    ' Add generic columns
    For c As Integer = 1 To cols
        dt.Columns.Add("Column" & c.ToString())
    Next

    For r As Integer = 1 To rows
        Dim dr As System.Data.DataRow = dt.NewRow()
        For c As Integer = 1 To cols
            Dim cell As Microsoft.Office.Interop.Excel.Range = CType(usedRange.Cells(r, c), Microsoft.Office.Interop.Excel.Range)
            Dim cellVal As Object = cell.Value2
            dr(c - 1) = If(cellVal IsNot Nothing, cellVal.ToString(), String.Empty)
            System.Runtime.InteropServices.Marshal.ReleaseComObject(cell)
        Next
        dt.Rows.Add(dr)
    Next

    dataTableResult = dt

Catch ex As Exception
    dataTableResult = New System.Data.DataTable()
    Throw
Finally
    ' Cleanup COM objects
    If usedRange IsNot Nothing Then
        System.Runtime.InteropServices.Marshal.ReleaseComObject(usedRange)
        usedRange = Nothing
    End If
    If worksheet IsNot Nothing Then
        System.Runtime.InteropServices.Marshal.ReleaseComObject(worksheet)
        worksheet = Nothing
    End If
    If workbook IsNot Nothing Then
        workbook.Close(False)
        System.Runtime.InteropServices.Marshal.ReleaseComObject(workbook)
        workbook = Nothing
    End If
    If excelApp IsNot Nothing Then
        excelApp.Quit()
        System.Runtime.InteropServices.Marshal.ReleaseComObject(excelApp)
        excelApp = Nothing
    End If
    GC.Collect()
    GC.WaitForPendingFinalizers()
End Try
